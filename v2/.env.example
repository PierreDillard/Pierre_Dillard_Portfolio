# Copy to .env.local to enable local editor authentication.
# Generate a long random value : openssl rand -base64 32
ADMIN_REQUIRE_AUTH=true
AUTH_SECRET=
# Credentials for a personal GitHub OAuth application.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Numeric ID of the authorized GitHub account, not its username.
ADMIN_GITHUB_ID=

# Storage proof, only on the dev/portfolio-storage Preview.
# Set these markers on the test branch, never in production.
STORAGE_PROBE_RUN=
STORAGE_PROBE_EXPECT_PREVIOUS_RUN=
# BLOB_STORE_ID is injected by the private store connection to Preview.

# Enable authentication only on the dev/portfolio-admin-online Preview.
# Without ADMIN_CONTENT_PREVIEW, only authentication is available outside local development.
ADMIN_AUTH_PREVIEW=false

# Private Blob editing, only on that same Preview branch.
# Requires complete OAuth configuration and the Preview store connection (BLOB_STORE_ID).
ADMIN_CONTENT_PREVIEW=false

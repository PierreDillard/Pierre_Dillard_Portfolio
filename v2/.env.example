# Copier dans .env.local pour activer la connexion de l'éditeur local.
# Générer une valeur longue et aléatoire : openssl rand -base64 32
ADMIN_REQUIRE_AUTH=true
AUTH_SECRET=
# Identifiants d'une application OAuth GitHub personnelle.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Identifiant numérique du compte GitHub autorisé, pas son nom d'utilisateur.
ADMIN_GITHUB_ID=

# Preuve de stockage, uniquement Preview sur dev/portfolio-storage.
# Définir ces marqueurs sur la branche de test, jamais en production.
STORAGE_PROBE_RUN=
STORAGE_PROBE_EXPECT_PREVIOUS_RUN=
# BLOB_STORE_ID est injecté par la connexion du store privé à Preview.
